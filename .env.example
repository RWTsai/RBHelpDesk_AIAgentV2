# =====================================================
# RBIT AI Agent 設定範本（To-Be）— 複製成 .env 後填入實際值
# 空值＝使用預設值或停用該功能
# =====================================================

# ---- 必要連線 ----
OPENAI_API_KEY=
MSSQL_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=10.1.1.11;DATABASE=RBDev_TEST;UID=;PWD=
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# ---- 模型 ----
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_MODEL_CHAT=gpt-5.1
# 快速路徑專用模型，空＝沿用 OPENAI_MODEL_CHAT
OPENAI_MODEL_FAST=
OPENAI_MODEL_VERIFY=gpt-4o-mini
OPENAI_MODEL_EXTRACT=gpt-4o
OPENAI_MODEL_VISION=gpt-4o
# 主控模型推理強度（none/low/medium/high），空＝不帶此參數
AGENT_REASONING_EFFORT=low

# ---- Agent ----
# on＝Agent 迴圈；off＝退回舊的固定管線
AGENT_MODE=on
AGENT_MAX_STEPS=4
AGENT_MAX_VERIFY_RETRY=1
AGENT_TOOL_RESULT_MAX_CHARS=4000
AGENT_FAST_PATH=on
QA_FAST_PATH_MIN_SCORE=0.80
QA_TRIPLE_EXPAND=on
VERIFY_ENABLED=on
VERIFY_EVIDENCE_MAX_CHARS=12000

# ---- 檢索 ----
RAG_QA_TOP_K=5
RAG_DOC_TOP_K=6
RAG_ENTITY_TOP_K=5
RAG_MIN_SCORE=0.30
RAG_CACHE_REFRESH_SEC=60

# ---- 唯讀 SQL 工具 ----
# 一般不用設：Skill 自己在資料夾裡帶連線（db.json）與表清單，丟進 skills/ 就會生效
# 詳見 skills/README.md 的「Skill 要查資料庫時」
#
# 這裡只在兩種情況才設：
#   1. 不屬於任何 Skill、由 IT 直接維護的資料庫
#   2. 要覆蓋某個 Skill 的連線或白名單（同名時 .env 優先）
# SQL_SOURCES=erp
# SQL_ERP_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=...;DATABASE=ERP;UID=;PWD=
# SQL_ERP_DESC=ERP 進銷存系統
# SQL_ERP_TABLES=@skill        # 或直接列表名、或 *（唯讀帳號權限）
SQL_SOURCES=

# 不論來源是 Skill 還是 .env，這裡列的表一律不給查（結尾 * 為前綴比對）
# 例如不想開放 PMM 的帳號權限相關：
# SQL_PMM_DENY_TABLES=BIPersonel,BSPersonalRoleMap,BSRole,BSRoleFunctionMap,PersonelPermission

# 舊版單一資料庫設定（仍可用，會變成名為 default 的來源）
MSSQL_READONLY_CONN=
SQL_ALLOWED_TABLES=
SQL_DEFAULT_DESC=

SQL_MAX_ROWS=50
SQL_TIMEOUT_SEC=10
# 白名單超過這個數量時，工具說明只列表名，欄位改由 describe_table 工具現查（避免提示詞爆量）
SQL_SCHEMA_INLINE_MAX=20

# ---- 網路搜尋（有值才啟用）----
SERPAPI_API_KEY=
WEB_SEARCH_NUM=5

# ---- Skill ----
# 空＝RBHelpDesk_AIAgent/skills
SKILLS_DIR=

# ---- 文件匯入（scheduler/ingest_docs.py）----
# 視覺解析：投影片／PDF 頁面文字太少（多為截圖、掃描版）時，把圖片送視覺模型轉文字再分塊
DOC_VISION_ENABLED=off
DOC_VISION_MIN_CHARS=100
DOC_VISION_MAX_IMAGES=4
DOC_VISION_MIN_PIXELS=40000
DOC_VISION_PDF_DPI=150
# 本機批次匯入資料夾，空＝不掃描
DOC_DROP_FOLDER=
DOC_ALLOWED_EXT=pdf,docx,xlsx,pptx,md,txt
INGEST_INTERVAL_SEC=300
INGEST_WORKERS=4
CHUNK_TOKENS=800
CHUNK_OVERLAP=100
EXCEL_ROWS_PER_CHUNK=50
ENTITY_DESC_MAX_CHARS=1500

# ---- Google Drive（service account）----
# 設定步驟詳見 scheduler/README.md 第六節
# 1) Cloud Console 建 service account、啟用 Drive API、下載 JSON 金鑰放到本機
# 2) 在 Drive 把資料夾「共用」給金鑰裡的 client_email（檢視者即可）
# 3) 資料夾 ID = 網址 /folders/ 後面那一段
GDRIVE_SA_JSON=
# 資料夾 ID，逗號分隔，子資料夾會自動一起掃；空＝不同步
GDRIVE_FOLDER_IDS=

# ---- M365 OneDrive / SharePoint（Entra ID 應用程式註冊，Graph 應用程式權限 Files.Read.All 或 Sites.Selected）----
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# 資料夾分享連結，逗號分隔，空＝不同步
ONEDRIVE_SHARE_URLS=
ONEDRIVE_RECURSIVE=on

# ---- LINE / 真人客服 ----
LINE_PUSH_FALLBACK_SEC=50
LINE_LOADING_SECONDS=30
ARTIFICIAL_TIMEOUT_MINUTES=15
